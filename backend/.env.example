DB_HOST=localhost
DB_PORT=5432
DB_NAME=travel_booking_db
DB_USER=travel_admin
DB_PASSWORD=your_password_here
PORT=5000

# Generate each of these with the commands in README (run once, paste the output)
JWT_SECRET=generate_with_node_crypto_randomBytes
# 64 hex characters (32 bytes). Encrypts passport numbers. Losing this key makes stored passports unreadable.
ENCRYPTION_KEY=generate_64_hex_characters
# Shared secret the agency website sends in the x-api-key header when pushing bookings
WEBSITE_API_KEY=generate_with_node_crypto_randomBytes

# Optional. Comma separated web origins allowed by CORS. Leave empty in development.
# CORS_ORIGIN=http://localhost:3000
# Set to production to stop returning the dev reset token from /forgot-password
# NODE_ENV=production
